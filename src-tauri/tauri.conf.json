{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaSonic",
  "version": "0.1.0",
  "identifier": "com.mangogetaway.novasonic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "NovaSonic",
      "width": 1320,
      "height": 840,
      "minWidth": 850,
      "minHeight": 590,
      "backgroundColor": "#0b0e16",
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
